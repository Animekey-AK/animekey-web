# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── NextAuth v5 ─────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000  # optional in dev — auto-detected

# ─── OAuth ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Payfort ─────────────────────────────────────────────────────────────────
PAYFORT_MERCHANT_IDENTIFIER=
PAYFORT_ACCESS_CODE=
PAYFORT_SHA_REQUEST_PHRASE=
PAYFORT_SHA_RESPONSE_PHRASE=
PAYFORT_BASE_URL=https://sbpaymentservices.payfort.com/FortAPI/paymentApi

# ─── Backend API ─────────────────────────────────────────────────────────────
API_BASE_URL=
API_KEY=

# ─── Guest session (Basic Auth — server-side only, never in client bundle) ───
# Fixes ANI-6: credentials were previously hardcoded in client JS
GUEST_BASIC_USER=
GUEST_BASIC_PASS=
